APP_ENV=development
DATABASE_URL=sqlite:///./data/scoutliq.db
APP_ORIGIN=http://localhost:8000
ADMIN_EMAIL=owner@example.com
# Configure uma senha exclusiva com no minimo 12 caracteres antes de iniciar.
ADMIN_PASSWORD=
DEMO_SEED=false
TZ=America/Sao_Paulo


# Cadastro e e-mail transacional (mesma infraestrutura Brevo do ecossistema ORLIQ).
REGISTRATION_MODE=open
# Em producao use brevo. Em desenvolvimento, console grava apenas no log local.
EMAIL_MODE=brevo
BREVO_API_KEY=
EMAIL_FROM_EMAIL=auth@orliq.com.br
EMAIL_FROM_NAME=ScoutLIQ
EMAIL_REPLY_TO=contato@orliq.com.br

# Mapa do Radar: MapTiler + MapLibre. A chave e publica no navegador; restrinja por Allowed HTTP origins no MapTiler Cloud.
RADAR_MAPTILER_API_KEY=
# Pode ser um estilo oficial (padrao: dataviz-v4-dark) ou o ID de um mapa personalizado da sua conta MapTiler.
RADAR_MAPTILER_STYLE_ID=dataviz-v4-dark

# Radar: em producao, use Geoapify. A chave fica somente no backend.
RADAR_PROVIDER=auto
RADAR_GEOAPIFY_API_KEY=
RADAR_GEOAPIFY_URL=https://api.geoapify.com
RADAR_HTTP_TIMEOUT=8
RADAR_GOOGLE_LINK_TIMEOUT=5
RADAR_DETAIL_TIMEOUT=4
RADAR_MAX_RESULTS=20
RADAR_ENRICH_LIMIT=12
RADAR_DETAIL_WORKERS=2
# Catálogo de municípios usado pelo autocomplete de localização.
RADAR_LOCATION_TIMEOUT=8
RADAR_IBGE_MUNICIPALITIES_URL=https://servicodados.ibge.gov.br/api/v1/localidades/municipios?orderBy=nome
# Opcional: identifique uma URL/contato próprio se alterar o User-Agent padrão.
# RADAR_USER_AGENT=ScoutLIQ/1.0 (+https://seu-dominio.example)

# Fallback de desenvolvimento. Não é usado automaticamente em producao.
RADAR_NOMINATIM_URL=https://nominatim.openstreetmap.org
RADAR_OVERPASS_URL=https://overpass.private.coffee/api/interpreter
# RADAR_OVERPASS_URLS=https://overpass.private.coffee/api/interpreter,https://overpass-api.de/api/interpreter,https://maps.mail.ru/osm/tools/overpass/api/interpreter

# Radar quality: fetch a larger candidate pool, then rank/filter before returning
RADAR_MAX_RESULTS=24
RADAR_CANDIDATE_LIMIT=72


# Pesquisa web do ScoutLIQ. Sem chave, o sistema ainda testa domínios prováveis e valida o site encontrado.
# Com Brave Search configurado, a análise também pesquisa a web e cruza resultados públicos.
SCOUT_BRAVE_SEARCH_API_KEY=
SCOUT_WEB_SEARCH_TIMEOUT=7
SCOUT_WEBSITE_TIMEOUT=5
SCOUT_WEBSITE_WORKERS=4
SCOUT_WEBSITE_CONFIRM_THRESHOLD=62

# ORLIQ Admin (use um segredo exclusivo de 32+ caracteres)
ORLIQ_ADMIN_API_KEY=

# Region-wide Radar pagination (Geoapify Places API)
RADAR_REGION_PAGE_SIZE=500
RADAR_REGION_MAX_RESULTS=2000
RADAR_REGION_SCAN_LIMIT=5000

# Executor de pesquisas: web e worker devem compartilhar o mesmo banco e modo.
RESEARCH_EXECUTION_MODE=worker
RESEARCH_LEASE_SECONDS=300
RESEARCH_MIN_INTERVAL_SECONDS=15
# Tarefas/tentativas por dia UTC; não representa número de chamadas HTTP ou custo.
RESEARCH_DAILY_BUDGET=100

# One web process and one worker supervised in the same service/volume.
SCOUTLIQ_PROCESS_MODE=combined
# Worker adapter operations, not billable requests or monetary cost.
RESEARCH_HTTP_DAILY_BUDGET=500
RESEARCH_PROVIDER_DAILY_LIMITS={"geoapify":100,"openstreetmap":100,"brave":100,"website":400}

# Optional P0.2 semantic preview. Disabled by default. Never sets a model implicitly.
# Uses official OpenAI Responses API; only the entered search request is transmitted.
SCOUT_SEMANTIC_ENABLED=false
SCOUT_SEMANTIC_MODEL=
SCOUT_SEMANTIC_API_KEY=
# UTC daily conservative reservations; shared installation and per-account limits.
# Zero disables. Set both explicitly; failed/uncertain requests retain their reservation.
SCOUT_SEMANTIC_DAILY_TOKENS=0
SCOUT_SEMANTIC_USER_DAILY_TOKENS=0
SCOUT_SEMANTIC_MAX_OUTPUT_TOKENS=2048
# Reservations are not provider billing; monetary costs remain unknown locally.

# Gmail oficial. Desabilitado por padrão; nunca usar as credenciais do ChatGPT.
GMAIL_ENABLED=false
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
# Deve ser exatamente APP_ORIGIN + /api/communication/gmail/callback.
GMAIL_REDIRECT_URI=
# Uma a três chaves Fernet separadas por vírgula, atual primeiro. Não compartilhar/commitar.
COMMUNICATION_TOKEN_KEYS=
# Tentativas por usuário/dia UTC, contando resultados incertos; 0 desabilita.
OUTREACH_DAILY_SEND_LIMIT=0
OUTREACH_MIN_INTERVAL_SECONDS=60
# Países explicitamente revisados pelo responsável; vazio bloqueia todos.
OUTREACH_ALLOWED_MARKETS=
# Acrescente "gmail":N a RESEARCH_PROVIDER_DAILY_LIMITS para permitir rede no worker.
# O limite Gmail é compartilhado pela instalação e conta refresh/leitura/reconciliação/envio.
# Unified search only invokes optional semantics for unresolved requests when
# this policy AND the existing model/key/token budgets are explicitly enabled.
SCOUT_SEMANTIC_AUTO_POLICY=disabled

# Autocomplete: reserved requests per UTC day, shared across web processes.
# 0 disables uncached paid-provider lookups. No monetary estimate is inferred.
RADAR_LOCATION_DAILY_CALLS=300
RADAR_LOCATION_USER_DAILY_CALLS=100
RADAR_LOCATION_CACHE_SECONDS=3600
